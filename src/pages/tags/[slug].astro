---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotesList from '../../components/NotesList.astro';
import { publishedNotes, terms } from '../../lib/notes';
export async function getStaticPaths() { return terms(await publishedNotes(), 'tags').map(([slug, group]) => ({ params: { slug }, props: { group } })); }
const { group } = Astro.props;
---
<BaseLayout title={`${group.name} · 标签`}><div class="page-shell compact-page"><a class="back-link" href="/tags/">← 全部标签</a><p class="eyebrow">TAG</p><h1># {group.name}</h1><p class="page-description">{group.notes.length} 篇相关笔记</p><NotesList notes={group.notes} /></div></BaseLayout>
