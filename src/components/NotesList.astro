---
import { dateLabel, noteUrl, termUrl, readingMinutes, type Note } from '../lib/notes';
interface Props { notes: Note[]; }
const { notes } = Astro.props;
---
<ul class="notes-list">
  {notes.map((note) => <li class="note-row">
    <div class="note-meta"><time datetime={dateLabel(note.data.date)}>{dateLabel(note.data.date)}</time><span aria-hidden="true">·</span><a href={termUrl('categories', note.data.category)}>{note.data.category}</a><span aria-hidden="true">·</span><span>约 {readingMinutes(note.body)} 分钟</span></div>
    <h2><a href={noteUrl(note.id)}>{note.data.title}<span class="note-arrow" aria-hidden="true">↗</span></a></h2>
    <p>{note.data.description}</p>
    <div class="tags">{note.data.tags.map((tag) => <a href={termUrl('tags', tag)}># {tag}</a>)}</div>
  </li>)}
</ul>
{notes.length === 0 && <p class="empty-state">这个目录还没有公开笔记。<a href="/">浏览全部笔记</a></p>}
